{
  "name": "tetrio-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot that turns the TETRA CHANNEL API (ch.tetr.io) into rich embeds. Slash commands + t? prefix commands.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
